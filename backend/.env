# Local development — created from .env.example.
# NOTE: .env is NOT covered by .gitignore in this repo. Do not commit it.

PORT=5000

SUPABASE_URL=https://odxoiandbvknsdokdsdt.supabase.co

# Currently the anon key, so every query goes through the RLS policies in
# db/schema.sql. Swap in the service-role key to bypass RLS and to enable
# login-by-mobile (routes/auth.js uses auth.admin.listUsers).
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im9keG9pYW5kYnZrbnNkb2tkc2R0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg0OTg1MTksImV4cCI6MjEwNDA3NDUxOX0.pT1xIW4LDLrL9Emr6Akl4UXQ6M0FvAzhaI3jz6e51mw

postgresql://postgres:@Thimidu1@db.odxoiandbvknsdokdsdt.supabase.co:5432/postgres
# Direct Postgres connection, used only by the one-off migration runner.
# The password begins with "@", so it is percent-encoded as %40 -- an
# unencoded @ makes the URI parser split the host at the wrong place.
SUPABASE_DB_URL=postgresql://postgres:%40Thimidu2003@db.odxoiandbvknsdokdsdt.supabase.co:5432/postgres

# Optional. Supabase dashboard → Project Settings → API → service_role.
# When set, registration creates confirmed accounts directly (no email,
# no rate limit). Leave blank to use the public signUp() flow.
# NEVER put this key in the frontend.
SUPABASE_SERVICE_ROLE_KEY=